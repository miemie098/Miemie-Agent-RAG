# ==========================================
# Miemie-Agent-RAG 环境变量配置模板
# ==========================================
# 使用方式: 复制此文件为 .env 并填入真实的 Key
#   cp .env.example .env
# ==========================================

# DeepSeek API Key (必填)
# 获取地址: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# ── 会话持久化 ──────────────────────────────────
# PostgreSQL 连接串（生产环境必填，启用集中式 Checkpointer）
# 格式: postgresql://<user>:<password>@<host>:5432/<dbname>
# 带 SSL: postgresql://<user>:<password>@<host>:5432/<dbname>?sslmode=require
#
# 设置后自动使用 AsyncPostgresSaver，所有 K8s Pod 共享同一会话状态，
# 实现跨副本的 thread_id 会话恢复。
#
# 不设置则自动回退到本地 SQLite（checkpoints.db），仅适合单机开发。
# DATABASE_URL=postgresql://miemie_user:changeme@localhost:5432/miemie_rag

# BGE-Reranker-Large 精排模型路径 (可选)
# 留空则自动从 HuggingFace Hub 下载 BAAI/bge-reranker-large
# 如已通过 download_models.py 下载到本地，填入本地路径即可:
# RERANKER_MODEL_PATH=/path/to/models_cache/Xorbits/bge-reranker-large

# 如需使用 HuggingFace 镜像加速（国内推荐），取消下一行注释:
# HF_ENDPOINT=https://hf-mirror.com
