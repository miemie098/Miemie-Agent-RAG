# ==========================================
# Miemie-Agent-RAG 环境变量配置模板
# ==========================================
# 使用方式: 复制此文件为 .env 并填入真实的 Key
#   cp .env.example .env
# ==========================================

# DeepSeek API Key (必填)
# 获取地址: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# 如果使用 HuggingFace 本地嵌入模型，不需要额外配置
# 如需使用 HuggingFace 镜像加速（国内推荐），取消下一行注释:
# HF_ENDPOINT=https://hf-mirror.com
